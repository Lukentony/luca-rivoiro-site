/assets/style.*.css
  Cache-Control: public, max-age=31536000, immutable
/assets/app.*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/theme.*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/images/*
  Cache-Control: public, max-age=14400, must-revalidate
/assets/fonts/*
  Cache-Control: public, max-age=14400, must-revalidate
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
